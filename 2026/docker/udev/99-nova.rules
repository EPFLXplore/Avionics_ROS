# Nova avionics master boards (STM32 USB-CDC, VID 0483 : PID 5740).
#
# The firmware sets the USB serial to "NOVA<board-id>" from the PB4/PB5 straps
# (see usbd_desc.c / Board_MasterId), so each master is identified by its ROLE,
# not by which physical chip or which order it was plugged in. udev then gives
# each a stable symlink: /dev/ttyNova0 .. /dev/ttyNova3.
#
# Install on the HOST (udev runs on the host; the container sees the symlinks via
# the mounted /dev):
#     sudo cp 99-nova.rules /etc/udev/rules.d/
#     sudo udevadm control --reload-rules && sudo udevadm trigger
# Check:  ls -l /dev/ttyNova*   and   udevadm info -a -n /dev/ttyACM0 | grep -i serial

# Named masters: serial "NOVA<id>" -> /dev/ttyNova<id>. The trailing GOTO stops
# the catch-all below from ALSO matching (which is what created the duplicate).
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTRS{serial}=="NOVA0", SYMLINK+="ttyNova0", GROUP="dialout", MODE="0660", GOTO="nova_end"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTRS{serial}=="NOVA1", SYMLINK+="ttyNova1", GROUP="dialout", MODE="0660", GOTO="nova_end"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTRS{serial}=="NOVA2", SYMLINK+="ttyNova2", GROUP="dialout", MODE="0660", GOTO="nova_end"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTRS{serial}=="NOVA3", SYMLINK+="ttyNova3", GROUP="dialout", MODE="0660", GOTO="nova_end"

# Fallback: a Nova board whose serial isn't NOVA0..3 (e.g. old UID-serial
# firmware) -> name it by its reported serial, e.g. /dev/ttyNova_208932755330.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", SYMLINK+="ttyNova_%s{serial}", GROUP="dialout", MODE="0660"

LABEL="nova_end"

# ---------------------------------------------------------------------------
# BMS serial link -> /dev/ttyBMS
#
# The USB-UART dongles are used for ONE purpose: connecting a BMS, and only
# ever one at a time. So there is no need to tell individual sticks apart --
# matching on the bridge chip's VID:PID is enough, and it means ANY dongle from
# the drawer works without re-editing this file.
#
# Per-stick matching would not work anyway: of the dongles checked, the FTDI and
# PL2303 report no serial at all and the CP2102 reports the factory default
# "0001" that Silicon Labs ships on every unprogrammed part.
#
# Verified against the physical dongles: CP2102 (10c4:ea60), FT232R (0403:6001),
# PL2303 (067b:2303). The rest are the usual families, listed pre-emptively.
#
# NOTE: these match ANY device using these bridge chips -- an ESP32 dev board
# (CH340/CP2102) plugged into this host would also claim /dev/ttyBMS. The Nova
# masters above are unaffected: they are 0483:5740 USB-CDC on ttyACM*.
# ---------------------------------------------------------------------------

# Prolific PL2303 (original + newer GC/GB/GT/GL/GE/GS silicon)
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2303", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="23a3", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="23b3", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="23c3", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="23d3", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="23e3", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="23f3", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"

# Silicon Labs CP210x  (CP2102/CP2102N single, CP2105 dual, CP2108 quad)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea70", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea71", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"

# WCH CH340 / CH341 / CH343 / CH9102
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="5523", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"

# FTDI FT232R / FT2232 / FT4232 / FT232H / FT231X
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6010", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6011", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", SYMLINK+="ttyBMS", GROUP="dialout", MODE="0660"
